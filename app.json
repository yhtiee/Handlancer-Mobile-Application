{
  "expo": {
    "name": "Handlancer",
    "slug": "handlancer",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "handlancer-mobile-application",
    "icon": "./assets/images/logo.png",
    "scheme": "handlancer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yhutiee.handlancer",
      "infoPlist": {
        "CFBundleDisplayName": "Handlancer",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yhutiee.handlancer",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 140,
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 140
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HandLancer to access your photos to upload proof of work.",
          "cameraPermission": "Allow HandLancer to use the camera to capture proof of work."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0FB5A4",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "519bc527-45ee-4148-bb88-bc2859a6fb0b"
      }
    }
  }
}
