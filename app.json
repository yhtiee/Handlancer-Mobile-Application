{
  "expo": {
    "name": "Handlancer",
    "slug": "handlancer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "handlancer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yhutiee.handlancer",
      "infoPlist": {
        "CFBundleDisplayName": "Handlancer"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yhutiee.handlancer"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 140,
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 140
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HandLancer to access your photos to upload proof of work.",
          "cameraPermission": "Allow HandLancer to use the camera to capture proof of work."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
