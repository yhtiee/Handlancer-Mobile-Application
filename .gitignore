*.p12
*.key
*.mobileprovision

# Firebase / FCM — this repository is public, so neither of these belongs in it.
# The service account key lets its holder send push as this project.
# google-services.json carries the Android API key: not confidential (it ships
# inside every APK) but harvestable from a public repo, so EAS supplies it as a
# secret file variable instead — see app.config.js.
*firebase-adminsdk*.json
*service-account*.json
google-services.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
